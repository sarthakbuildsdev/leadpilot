PORT=3000
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=leadpilot

# Optional: a single connection URL. When set, it takes precedence over the
# PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE values above. Leave it commented
# out for the normal local PostgreSQL setup.
# DATABASE_URL=postgres://user:your_password@localhost:5432/leadpilot

# Required for signed session cookies. Generate a unique value locally, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit your real .env file.
SESSION_SECRET=replace-this-with-at-least-32-random-characters
SESSION_DAYS=7
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
NODE_ENV=development
